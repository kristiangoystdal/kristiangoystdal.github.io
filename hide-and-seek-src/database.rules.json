{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{6}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{6}$/)",
        "created": {
          ".validate": "newData.isNumber()"
        },
        "active": {
          ".validate": "newData.isNumber()"
        },
        "round": {
          ".validate": "newData.isString() && newData.val().length < 2000"
        },
        "setup": {
          ".validate": "newData.isString() && newData.val().length < 20000"
        },
        "players": {
          ".validate": "newData.isString() && newData.val().length < 2000"
        },
        "questions": {
          "$id": {
            ".validate": "newData.isString() && newData.val().length < 2000"
          }
        },
        "ignored": {
          "$id": {
            ".validate": "newData.isString() && newData.val().length < 200"
          }
        },
        "notes": {
          "$id": {
            ".validate": "newData.isString() && newData.val().length < 1000"
          }
        },
        "results": {
          "$id": {
            ".validate": "newData.isString() && newData.val().length < 1500"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "archive": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{6}$/)",
        "$id": {
          ".write": "auth != null && $code.matches(/^[A-Z0-9]{6}$/) && $id.matches(/^[a-z0-9]{1,20}$/)",
          ".validate": "newData.isString() && newData.val().length < 500000"
        }
      }
    },
    "presets": {
      ".read": true,
      ".indexOn": ["city", "owner"],
      "$id": {
        ".write": "auth != null && $id.matches(/^[a-z0-9]{8,24}$/) && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
        ".validate": "newData.hasChildren(['owner', 'name', 'city', 'setup', 'hidingMinutes', 'created'])",
        "owner": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "city": { ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,20}$/)" },
        "setup": { ".validate": "newData.isString() && newData.val().length < 20000" },
        "hidingMinutes": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1440" },
        "created": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "updated": { ".validate": "newData.isNumber()" },
        "uses": {
          ".write": "auth != null && data.parent().exists()",
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        },
        "reports": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && data.parent().parent().exists()",
            ".validate": "newData.val() === true"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
